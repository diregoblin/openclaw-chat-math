{
  "name": "openclaw-chat-math",
  "version": "0.1.0-alpha.2",
  "type": "module",
  "license": "MIT",
  "description": "Math-only LaTeX rendering in the native OpenClaw Control UI transcript",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.ts",
    "compat": {
      "pluginApi": "2026.9.9"
    },
    "build": {
      "openclawVersion": "2026.9.9"
    },
    "install": {
      "minHostVersion": ">=2026.9.9"
    }
  },
  "scripts": {
    "test": "node --test test/math.test.mjs",
    "build": "node scripts/build.mjs",
    "pack": "node scripts/pack.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "dompurify": "3.4.16",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.0",
    "katex": "0.18.6",
    "markdown-it": "15.0.2"
  },
  "homepage": "https://github.com/diregoblin/openclaw-chat-math",
  "repository": {
    "type": "git",
    "url": "https://github.com/diregoblin/openclaw-chat-math.git"
  },
  "bugs": {
    "url": "https://github.com/diregoblin/openclaw-chat-math/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "latex",
    "mathml",
    "katex"
  ],
  "engines": {
    "node": ">=24.16.0"
  }
}
